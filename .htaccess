# White Sea Star — Apache configuration (one.com shared hosting).
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Never expose application code or private storage.
    RewriteRule ^(includes|pages|storage)(/|$) - [F,L]

    # Serve real static files directly (assets, favicon, etc.).
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_FILENAME} !\.php$ [NC]
    RewriteRule ^ - [L]

    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # All other requests go through the front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# Block dotfiles such as .env and .git.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
